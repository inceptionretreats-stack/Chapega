NEXT_PUBLIC_APP_NAME=Chapega.com
NEXT_PUBLIC_DEFAULT_COUNTRY_CODE=91
NEXT_PUBLIC_DEFAULT_MAX_CART_QUANTITY=5
NEXT_PUBLIC_SHOW_PREVIEW_LABEL=false

# Vendor Studio (server-only; never prefix these with NEXT_PUBLIC_)
# The sample account works in development only. Replace both values in production.
VENDOR_EMAIL=owner@chapega.com
VENDOR_PASSWORD=replace-with-a-long-unique-password
VENDOR_NAME=Aanya
VENDOR_SESSION_HOURS=12
# Vercel client-IP headers are trusted automatically. For another trusted reverse
# proxy, set this to true; set false to disable all proxy-header trust.
# TRUST_PROXY_HEADERS=true
# Emergency local preview override; never enable on a public deployment.
# ALLOW_VENDOR_PREVIEW_LOGIN=false
CHAPEGA_OWNER_WHATSAPP_NUMBER=919876543210
# Local development backend. Production should use "supabase".
CHAPEGA_DATA_BACKEND=local
# Optional absolute directory for the local JSON data store.
# CHAPEGA_DATA_DIR=D:\path\to\private\data
# Explicit emergency override for a private production preview only.
# ALLOW_LOCAL_VENDOR_BACKEND=false

# Supabase production backend. Keep all credentials except the project URL server-only.
# NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SECRET_KEY=sb_secret_replace_me
# Runtime traffic must use the restricted role created by `npm run supabase:provision`.
# SUPABASE_DATABASE_URL=postgresql://chapega_app.your-project-ref:URL_ENCODED_APP_PASSWORD@your-transaction-pooler-host:6543/postgres
# The owner URL is used only for migrations and role provisioning, never by the app.
# SUPABASE_ADMIN_DATABASE_URL=postgresql://postgres.your-project-ref:URL_ENCODED_OWNER_PASSWORD@your-transaction-pooler-host:6543/postgres

{
  "name": "chapega-com",
  "version": "0.1.0",
  "private": true,
  "license": "UNLICENSED",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint app components data domain server scripts store types tests vitest.config.mts vitest.integration.config.mts vitest.setup.ts instrumentation.ts playwright.config.ts next.config.ts",
    "supabase:import:check": "node --conditions=react-server --import tsx scripts/import-vendor-to-supabase.ts --dry-run",
    "supabase:import": "node --conditions=react-server --import tsx scripts/import-vendor-to-supabase.ts --confirm-import",
    "supabase:provision": "node --import tsx scripts/provision-supabase-role.ts --confirm-provision",
    "supabase:verify": "node --import tsx scripts/verify-supabase.ts",
    "supabase:bootstrap-owner": "node --conditions=react-server --import tsx scripts/bootstrap-supabase-owner.ts --confirm-bootstrap",
    "vendor:password": "node --conditions=react-server --import tsx scripts/rotate-vendor-password.ts --confirm-rotation",
    "typecheck": "next typegen && tsc --noEmit --incremental false",
    "check": "npm run -s typecheck && npm run -s lint && vitest run --silent",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:integration": "vitest run --config vitest.integration.config.mts",
    "test:e2e": "playwright test",
    "prepare": "node .husky/install.mjs",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@supabase/supabase-js": "2.116.0",
    "lucide-react": "^1.31.0",
    "next": "16.3.8",
    "postgres": "3.4.9",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-qr-code": "^2.2.0",
    "server-only": "0.0.1",
    "zod": "^4.4.3",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@vitest/coverage-v8": "4.1.11",
    "eslint": "^9",
    "eslint-config-next": "16.3.8",
    "husky": "9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "17.5.1",
    "prettier": "3.9.8",
    "supabase": "2.117.0",
    "tailwindcss": "^4",
    "tsx": "4.23.13",
    "typescript": "^5",
    "vitest": "4.1.11"
  },
  "lint-staged": {
    "*.{ts,tsx,mts,mjs,js,cjs}": [
      "eslint --fix --max-warnings=0",
      "prettier --write"
    ],
    "*.{css,json,yml,yaml}": "prettier --write"
  }
}
